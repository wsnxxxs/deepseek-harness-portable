+  // Node resolution walks node_modules up the directory chain, and the profile
+  // is built that way: a marketplace install lands in the profile's own
+  // node_modules, while the harness's own packages resolve from the
+  // installation fallback tree one level above it. Reading only the profile
+  // directory therefore found third-party installs and reported every builtin
+  // as an unknown version. Walk the same chain the loader walked.
+  let dir = webProfileDir()
+  for (;;) {
+    const path = join(dir, 'node_modules', ...rel, 'package.json')
+    if (existsSync(path)) {
+      try { return JSON.parse(readFileSync(path, 'utf8')) } catch { return null }
+    }
+    const parent = dirname(dir)
+    if (parent === dir) return null
+    dir = parent
+  }
 }
 
