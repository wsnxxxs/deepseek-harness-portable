{
  "name": "@dsh-portable/desktop-enhancements",
  "version": "0.1.0",
  "private": true,
  "description": "Opt-in desktop menus, notices and page styling",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "client": {
      "inject": [],
      "external": [],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/**/*.css",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -b && tsdown"
  },
  "dependencies": {},
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "tsdown": "^0.22.2",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  }
}
