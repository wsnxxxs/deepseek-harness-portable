{
  "name": "@dsh-portable/ui-mode",
  "version": "0.1.0",
  "private": true,
  "description": "Shared UI-mode vocabulary, page-wide mode store, and the interface switch in official settings",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./ui-mode": {
      "types": "./lib/types/ui-mode.d.ts",
      "default": "./lib/ui-mode.js"
    },
    "./ui-mode-contract": {
      "types": "./ui-mode-contract.d.cts",
      "default": "./ui-mode-contract.cjs"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ],
      "external": [],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/ui-mode.js",
    "ui-mode-contract.cjs",
    "ui-mode-contract.d.cts",
    "lib/**/*.css",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc -b && tsdown",
    "bundle": "tsdown",
    "watch": "tsdown --watch",
    "test": "tsc -b && node --test tests/*.test.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@deepseek-ai/dsh-client-locale": "workspace:^",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:^",
    "@deepseek-ai/dsh-client-ui-settings": "workspace:^",
    "@deepseek-ai/dsh-client-ui-settings-general": "workspace:^",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.8.2",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  }
}
