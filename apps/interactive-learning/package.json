{
  "name": "@dsh-portable/interactive-learning",
  "version": "0.1.0",
  "description": "Installable Interactive Learning Agent experience pack for DeepSeek Harness",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-learning-preset": "lib/installer-cli.js",
    "dsh-learning-eval": "lib/eval-cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./agent": {
      "types": "./lib/types/agent.d.ts",
      "default": "./lib/agent.js"
    },
    "./bootstrap": {
      "types": "./lib/types/bootstrap.d.ts",
      "default": "./lib/bootstrap.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./protocol": {
      "types": "./lib/types/protocol.d.ts",
      "default": "./lib/protocol.js"
    },
    "./installer": {
      "types": "./lib/types/installer.d.ts",
      "default": "./lib/installer.js"
    },
    "./preset": {
      "types": "./lib/types/preset.d.ts",
      "default": "./lib/preset.js"
    },
    "./eval": {
      "types": "./lib/types/eval.d.ts",
      "default": "./lib/eval.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-user-questions",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/*.js",
    "lib/*.js.map",
    "lib/types/index.d.ts",
    "lib/types/agent.d.ts",
    "lib/types/bootstrap.d.ts",
    "lib/types/broker.d.ts",
    "lib/types/client/index.d.ts",
    "lib/types/client/lifecycle.d.ts",
    "lib/types/client/VaultKeep.d.ts",
    "lib/types/client/VaultRoster.d.ts",
    "lib/types/client/VaultView.d.ts",
    "lib/types/client/vault-gate.d.ts",
    "lib/types/eval.d.ts",
    "lib/types/installer.d.ts",
    "lib/types/learn-intent.d.ts",
    "lib/types/learner-state.d.ts",
    "lib/types/protocol-errors.d.ts",
    "lib/types/protocol-current.d.ts",
    "lib/types/preset.d.ts",
    "lib/types/protocol.d.ts",
    "lib/types/protocol-schema.d.ts",
    "lib/types/teaching-policy.d.ts",
    "lib/types/teaching-route.d.ts",
    "lib/types/ingest/index.d.ts",
    "lib/types/ingest/markdown.d.ts",
    "lib/types/ingest/pipeline.d.ts",
    "lib/types/ingest/text.d.ts",
    "lib/types/ingest/types.d.ts",
    "lib/types/learner-locale.d.ts",
    "lib/types/learner-memory.d.ts",
    "lib/types/concept-cards.d.ts",
    "lib/types/concept-tools.d.ts",
    "lib/types/material-intake.d.ts",
    "lib/types/material-tools.d.ts",
    "lib/types/topic-vault.d.ts",
    "lib/types/material-anchor.d.ts",
    "lib/types/material-reanchor.d.ts",
    "lib/types/material-validation.d.ts",
    "lib/types/material-retrieval.d.ts",
    "lib/types/index.d.ts.map",
    "lib/types/agent.d.ts.map",
    "lib/types/bootstrap.d.ts.map",
    "lib/types/broker.d.ts.map",
    "lib/types/client/index.d.ts.map",
    "lib/types/client/lifecycle.d.ts.map",
    "lib/types/client/VaultKeep.d.ts.map",
    "lib/types/client/VaultRoster.d.ts.map",
    "lib/types/client/VaultView.d.ts.map",
    "lib/types/client/vault-gate.d.ts.map",
    "lib/types/eval.d.ts.map",
    "lib/types/installer.d.ts.map",
    "lib/types/learn-intent.d.ts.map",
    "lib/types/learner-state.d.ts.map",
    "lib/types/protocol-errors.d.ts.map",
    "lib/types/protocol-current.d.ts.map",
    "lib/types/preset.d.ts.map",
    "lib/types/protocol.d.ts.map",
    "lib/types/protocol-schema.d.ts.map",
    "lib/types/teaching-policy.d.ts.map",
    "lib/types/teaching-route.d.ts.map",
    "lib/types/ingest/index.d.ts.map",
    "lib/types/ingest/markdown.d.ts.map",
    "lib/types/ingest/pipeline.d.ts.map",
    "lib/types/ingest/text.d.ts.map",
    "lib/types/ingest/types.d.ts.map",
    "lib/types/learner-locale.d.ts.map",
    "lib/types/learner-memory.d.ts.map",
    "lib/types/concept-cards.d.ts.map",
    "lib/types/concept-tools.d.ts.map",
    "lib/types/material-intake.d.ts.map",
    "lib/types/material-tools.d.ts.map",
    "lib/types/topic-vault.d.ts.map",
    "lib/types/material-anchor.d.ts.map",
    "lib/types/material-reanchor.d.ts.map",
    "lib/types/material-validation.d.ts.map",
    "lib/types/material-retrieval.d.ts.map",
    "preset/**/*",
    "README.zh.md"
  ],
  "scripts": {
    "build": "node scripts/build-package.mjs",
    "bundle": "pnpm run build",
    "test:source": "vitest run",
    "test": "pnpm run test:source && pnpm run test:package",
    "eval": "node lib/eval-cli.js",
    "test:package:purity": "node tests/package-purity.mjs lib",
    "test:package": "pnpm run build && node tests/package-lifecycle.mjs",
    "package:prepare": "pnpm run build && pnpm run test:package:purity && node scripts/assert-package-output.mjs",
    "prepack": "pnpm run package:prepare",
    "prepublishOnly": "pnpm run package:prepare"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-client-locale": "workspace:^",
    "@deepseek-ai/dsh-client-ui-chat": "workspace:^",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:^",
    "@deepseek-ai/dsh-client-ui-session": "workspace:^",
    "@deepseek-ai/dsh-client-ui-user-questions": "workspace:^",
    "@deepseek-ai/dsh-client-ui-conversation": "workspace:^",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:^",
    "@deepseek-ai/dsh-client-ui-sidebar": "workspace:^",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "@deepseek-ai/dsh-client-ui-tool": "workspace:^",
    "@deepseek-ai/dsh-api-session-controller": "workspace:^",
    "@deepseek-ai/dsh-client-modules": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-system-prompt": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^",
    "@deepseek-ai/dsh-user-questions": "workspace:^",
    "react": "^18.3.1"
  },
  "optionalDependencies": {
    "unpdf": "^1.3.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent-presets": "workspace:^",
    "@deepseek-ai/dsh-api-remotes": "workspace:^",
    "@deepseek-ai/dsh-session-persistence-jsonl": "workspace:^",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
