{
  "name": "dsh-desktop-web-pkg",
  "productName": "DeepSeek Harness",
  "description": "Cross-platform Electron desktop shell for the DeepSeek Harness runtime capsule.",
  "version": "0.1.0-shell.2",
  "distributionVersion": "1.7.2",
  "private": true,
  "type": "module",
  "main": "src/main.cjs",
  "files": [
    "src",
    "assets"
  ],
  "scripts": {
    "build": "node --check src/main.cjs && node --check src/runtime-supervisor.cjs",
    "start": "electron .",
    "test": "node --test \"src/!(process-tree).test.cjs\" && node ../../scripts/check-syntax.mjs src",
    "test:platform": "node --test src/process-tree.test.cjs && pnpm run updater:test",
    "updater:test": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/Run-Tests.ps1",
    "package:win": "pnpm exec tsx ../../scripts/build-desktop-web-exe.ts --electron --target win32-x64",
    "make:win": "pnpm run package:win",
    "package:mac": "pnpm exec tsx ../../scripts/build-desktop-web-exe.ts --electron --target darwin-arm64",
    "make:mac": "pnpm run package:mac",
    "package:linux": "pnpm exec tsx ../../scripts/build-desktop-web-exe.ts --electron --target linux-x64",
    "make:linux": "pnpm run package:linux"
  },
  "dependencies": {
    "@dsh-portable/desktop-protocol": "workspace:^",
    "@dsh-portable/ui-mode": "workspace:^",
    "js-yaml": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@electron/packager": "20.0.4",
    "electron": "43.4.0",
    "rcedit": "5.0.2"
  }
}
